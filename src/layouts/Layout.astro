---
import '../styles/site.css';
import '../styles/details.css';
interface Props { title?:string; description?:string; noindex?:boolean; }
const { title='Decompiled games. Ready for another life.',description='Discover decompiled games, open-source ports, and classic games you can play in your browser. Explore source projects, controls, and local game-file support.',noindex=false }=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
const path=Astro.url.pathname;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} — Decomp Games</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta name="theme-color" content="#11141b"/><meta property="og:title" content={`${title} — Decomp Games`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/>{noindex && <meta name="robots" content="noindex,follow"/>}<link rel="alternate" type="application/rss+xml" title="Decomp Games updates" href="/feed.xml"/></head>
<body><a class="skip" href="#main">Skip to content</a><header class="topbar"><a href="/" class="brand" aria-label="Decomp Games home"><img src="/favicon.svg" width="32" height="32" alt=""/><span>decomp<span class="brand-light">games</span><span class="brand-dot">.</span></span></a><nav aria-label="Main navigation"><a href="/games/" aria-current={path.startsWith('/games')?'page':undefined}>Explore games</a><a href="/collections/" aria-current={path.startsWith('/collections')?'page':undefined}>Collections</a><a href="/guides/" aria-current={path.startsWith('/guides')?'page':undefined}>Field guide</a></nav><a class="source-link" href="https://github.com/andrewnakas/decompgames" target="_blank" rel="noopener">Source on GitHub <span aria-hidden="true">↗</span></a></header>
<div class="site-shell"><aside class="sidebar"><p class="nav-caption">YOUR NEXT PLAY</p><a class:list={['side-link',{selected:path==='/'||path==='/games/'}]} href="/games/"><span aria-hidden="true">▦</span> All games</a><a class="side-link" href="/collections/instant-play/"><span aria-hidden="true">▷</span> Instant play</a><a class="side-link" href="/collections/bring-your-files/"><span aria-hidden="true">▱</span> Bring your files</a><a class="side-link" href="/collections/decompilations/"><span aria-hidden="true">⌘</span> Decompilations</a><div class="side-divider"></div><p class="nav-caption">THE PROJECT</p><a class="side-link" href="/guides/getting-started/">Getting started</a><a class="side-link" href="/updates/">What’s new</a><a class="side-link" href="/about/">About & principles</a><a class="side-link" href="/contribute/">Add a game <span aria-hidden="true">↗</span></a><div class="sidebar-note"><span class="tiny-code">{'>_'} OPEN BY DESIGN</span><p>Old games.<br/>New possibilities.</p><a href="/about/#open-source">Built in the open ↗</a></div></aside><main id="main"><p class="development-note">Development preview · Game integrations are still being tested. See each game’s test record before playing.</p><slot/></main></div>
<footer><a class="footer-brand" href="/">decompgames.</a><p>A new home for games with more life in them.</p><nav aria-label="Footer"><a href="/licenses/">Licenses & credits</a><a href="/privacy/">Privacy</a><a href="/contribute/">Contribute</a><a href="https://exebrowser.com/">By the creator of ExeBrowser ↗</a></nav><small>Independent community project. Game names and artwork belong to their respective owners.</small></footer></body></html>
