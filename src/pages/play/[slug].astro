---
import {games} from '../../lib/catalog';
import '../../styles/site.css';
import '../../styles/details.css';
export function getStaticPaths(){return games.filter(g=>g.mode!=='project').map(game=>({params:{slug:game.id},props:{game}}));}
const {game:g}=Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Play {g.title} — Decomp Games</title><meta name="robots" content="noindex,follow"/><link rel="icon" href="/favicon.svg"/></head><body class="player-body"><header class="player-header"><a href={`https://decompgames.com/games/${g.id}/`}>← Game guide</a><h1>{g.title}</h1><button id="fullscreen" class="button">Fullscreen</button></header><main class="player-main" id="player" data-game={g.id} data-engine={g.runtime}><div id="stage" class="player-stage"><div id="launch-panel"><span class="eyebrow">READY WHEN YOU ARE</span><h2>{g.title}</h2><p>{g.assetRequirements}</p>{g.mode==='files'&&<div class="import-fields"><label class="button">Choose files or ZIP<input id="game-files" type="file" multiple accept=".wad,.pak,.zip"/></label><label class="button">Choose a folder<input id="game-folder" type="file" webkitdirectory multiple/></label><p id="file-summary">Files are read on this device. They are never uploaded.</p></div>}<button class="button primary" id="start-game">Start game ▷</button><p class="small-note">{g.downloadMB?`Approximately ${g.downloadMB} MB. `:''}Keyboard and mouse recommended.</p></div><iframe id="game-frame" title={`${g.title} game canvas`} hidden allow="fullscreen; gamepad; autoplay" sandbox="allow-scripts allow-same-origin allow-pointer-lock allow-downloads"></iframe></div><p id="player-status" role="status" aria-live="polite">Game packages load only after you press Start.</p><div class="player-tools"><button id="stop-game" class="button" disabled>Stop game</button><button id="export-save" class="button" disabled>Export saves</button><label class="button">Import saves<input id="import-save" type="file" accept=".json,application/json" disabled/></label><button id="delete-save" class="button" disabled>Delete saves</button><a class="button" href={`/games/${g.id}/#requirements`}>Controls & help</a></div><details class="player-help"><summary>Controls and save guidance</summary><ul>{g.controls.map(c=><li>{c}</li>)}</ul><p>{g.saveInstructions}</p><p>Save inside the game before exporting a backup. Clearing browser data can erase progress.</p></details><noscript>This player requires JavaScript and WebAssembly.</noscript></main><script>import '../../player/controller';</script></body></html>
