---
import {games} from '../../lib/catalog';
import '../../styles/site.css';
import '../../styles/details.css';
export function getStaticPaths(){return games.filter(g=>g.mode!=='embed').map(game=>({params:{slug:game.id},props:{game}}));}
const {game:g}=Astro.props;
const gaId=import.meta.env.PUBLIC_GA_ID || 'G-GQ6627GN8H';
const controls=g.controls.map(line=>{const at=line.indexOf(' — ');return at<0?['',line]:[line.slice(0,at),line.slice(at+3)];});
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
  <title>Play {g.title} — Decomp Games</title>
  <meta name="robots" content="noindex,follow"/>
  <meta name="theme-color" content="#0e0d0b"/>
  <link rel="icon" href="/favicon.svg"/>
  {gaId && (
    <Fragment>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
      <script is:inline define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag('js', new Date());
        if (!navigator.webdriver) gtag('config', gaId);
      </script>
    </Fragment>
  )}
</head>
<body class="player-body">
  <header class="player-header"><a href={`/games/${g.id}/`}>← {g.title}</a><h1>{g.title}</h1><button id="fullscreen" class="button">Fullscreen</button></header>
  <main class="player-main" id="player" data-game={g.id} data-engine={g.runtime} data-platform={g.platform} data-shelf={g.shelf}>
    <div id="stage" class="stage">
      <div id="launch-panel">
        <h2>{g.title}</h2>
        <p>{g.assetRequirements}</p>
        {g.mode==='files'&&<div class="import-fields"><label class="button">Choose files or ZIP<input id="game-files" type="file" multiple accept=".wad,.pak,.zip"/></label><label class="button">Choose a folder<input id="game-folder" type="file" webkitdirectory multiple/></label><p id="file-summary">Files are read on this device. They are never uploaded.</p></div>}
        <button class="play-button" id="start-game">▶ Play</button>
        <p>{g.downloadMB?`About ${g.downloadMB} MB. `:''}Keyboard and mouse recommended.</p>
      </div>
      <iframe id="game-frame" title={`${g.title} game canvas`} hidden allow="fullscreen; gamepad; autoplay" sandbox="allow-scripts allow-same-origin allow-pointer-lock allow-downloads"></iframe>
    </div>
    <p id="player-status" class="stage-status" role="status" aria-live="polite">The game downloads only after you press Play. Sound starts off.</p>
    <div class="stage-tools">
      <button id="toggle-sound" class="button" aria-pressed="false" disabled>Sound: off</button>
      <button id="stop-game" class="button" disabled>Stop game</button>
      <button id="export-save" class="button" disabled>Export saves</button>
      <label class="button">Import saves<input id="import-save" type="file" accept=".json,application/json" disabled/></label>
      <button id="delete-save" class="button" disabled>Delete saves</button>
    </div>
    <section class="card">
      <details class="fold" open>
        <summary>Controls</summary>
        <table class="controls"><tbody>{controls.map(([input,action])=><tr><td>{input&&<kbd>{input}</kbd>}</td><td>{action}</td></tr>)}</tbody></table>
      </details>
      <p class="muted" style="margin-top:1rem">{g.saveInstructions} Save inside the game before exporting a backup. Clearing browser data can erase progress.</p>
    </section>
    <noscript>This player requires JavaScript and WebAssembly.</noscript>
  </main>
  <script>import '../../player/controller';</script>
</body>
</html>
