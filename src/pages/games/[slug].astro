---
import {existsSync,readFileSync} from 'node:fs';
import Layout from '../../layouts/Layout.astro';
import GameCard from '../../components/GameCard.astro';
import { games, labels, playerUrl } from '../../lib/catalog';
export function getStaticPaths(){return games.map(game=>({params:{slug:game.id},props:{game}}));}
const {game:g}=Astro.props;
const manifestPath=`public/manifests/${g.id}.json`;
const runtime=existsSync(manifestPath)?JSON.parse(readFileSync(manifestPath,'utf8')):null;
const related=games.filter(x=>x.id!==g.id&&(x.genre===g.genre||x.kind===g.kind)).slice(0,3);
const schema={'@context':'https://schema.org','@type':'VideoGame',name:g.title,description:g.description,genre:g.genre,url:new URL(`/games/${g.id}/`,Astro.site),sameAs:g.source};
---
<Layout title={`${g.title} — browser play & project guide`} description={g.description}>
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/games/">Games</a><span aria-hidden="true">/</span><span>{g.title}</span></nav>
  <div class="game-heading"><div><span class="eyebrow">{g.kind} · {g.year}</span><h1 class="page-title">{g.title}</h1><p class="game-lead">{g.description}</p><div class="game-actions">{g.mode!=='project'?<a class="button primary" href={playerUrl(g.id)}>{g.verification.status==='gameplay-tested'?labels[g.mode]:'Try browser build'} <span aria-hidden="true">▷</span></a>:<a class="button primary" href={g.source} target="_blank" rel="noopener">View source project ↗</a>}<a class="button" href="#requirements">Before you play ↓</a></div></div>{g.image&&<img class="detail-art" src={g.image} alt={`${g.title} gameplay`} width="640" height="400"/>}</div>
  <div class="detail-grid"><article class="prose"><h2>A classic, rebuilt</h2><p>{g.overview}</p><h2 id="requirements">What you need</h2><p>{g.assetRequirements}</p>{g.mode==='project'&&<p>This is a discovery entry. We do not currently provide a supported browser build. Follow the upstream project for its installation instructions and supported platforms.</p>}<h2>Controls & input</h2><ul>{g.controls.map(c=><li>{c}</li>)}</ul><h2>Saving your progress</h2><p>{g.saveInstructions}</p>{g.mode!=='project'&&<p>Browser data can be cleared by your browser or operating system. Export a backup from the player before clearing site data or moving devices. Private browsing may not retain saves.</p>}<h2>Known limitations</h2><ul>{g.limitations.map(l=><li>{l}</li>)}</ul><h2>Source & assets</h2><p>The engine and game data have separate licenses. A source release does not automatically make the original artwork, music, or levels freely redistributable.</p><p><a href={g.source} target="_blank" rel="noopener">{g.engine} source repository ↗</a></p>{runtime&&<section><h2>Build & corresponding source</h2><p>This experimental package was compiled with {runtime.toolchain} from revision <code>{runtime.sourceRevision}</code>.</p><ul><li><a href={runtime.sourceArchive}>Download corresponding source and patches</a></li><li><a href={`/manifests/${g.id}.json`}>Runtime manifest and checksums</a></li><li><a href="https://github.com/andrewnakas/decompgames/blob/main/scripts/build-engines.sh">Build instructions</a></li><li><a href="https://github.com/andrewnakas/decompgames/tree/main/provenance">Asset sources and license notices</a></li></ul></section>}</article><aside class="fact-panel"><h2>At a glance</h2><dl><dt>Project</dt><dd>{g.engine}</dd><dt>Category</dt><dd>{g.kind}</dd><dt>Genre</dt><dd>{g.genre}</dd><dt>Engine license</dt><dd>{g.engineLicense}</dd><dt>Asset license</dt><dd>{g.assetLicense}</dd><dt>Download</dt><dd>{g.downloadMB?`Approximately ${g.downloadMB} MB`:'See upstream project'}</dd></dl><h2>Test record</h2><p class="test-status">{g.verification.status.replaceAll('-',' ')}</p><p>{g.verification.scope}</p><dl><dt>Tested browsers</dt><dd>{g.verification.browsers.join(', ')||'No browser claim yet'}</dd><dt>Last test</dt><dd>{g.verification.date||'Pending'}</dd><dt>Full playthrough</dt><dd>{g.verification.playthrough?'Verified':'Not verified'}</dd></dl><a href="/guides/verification/">How we verify games ↗</a></aside></div>
  <div class="section-heading"><h2>Keep exploring</h2></div><div class="game-grid">{related.map(game=><GameCard game={game}/>)}</div>
  <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/>
</Layout>
