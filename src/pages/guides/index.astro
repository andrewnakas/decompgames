const guides=[['openrct2-local-files','OpenRCT2 files and browser status','Installation folders, park saves, and the work still needed for browser play.'],['getting-started','Getting started','Choose a game, understand its requirements, and keep your progress.'],['local-files','Bring your own game files','WADs, PAKs, compatible editions, and local imports.'],['decompilation-vs-recompilation','What kind of project is this?','Decompilations, recompilations, recreations, and source ports.'],['verification','What “tested” actually means','How we separate startup checks from a complete playthrough.']];
