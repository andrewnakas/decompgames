---
import Layout from '../../layouts/Layout.astro';
const guides=[['getting-started','Getting started','Choose a game, understand its requirements, and keep your progress.'],['local-files','Bring your own game files','WADs, PAKs, compatible editions, and local imports.'],['decompilation-vs-recompilation','What kind of project is this?','Decompilations, recompilations, recreations, and source ports.'],['verification','What “tested” actually means','How startup checks are kept separate from a complete playthrough.'],['openrct2-local-files','OpenRCT2 files and browser status','Installation folders, park saves, and the work still needed for browser play.']];
---
<Layout title="Guides"><section class="card"><h1 class="page-title">Guides</h1><div class="tile-grid">{guides.map(([id,title,description])=><a class="tile" href={`/guides/${id}/`}><h2>{title}</h2><p>{description}</p><span>Read guide ›</span></a>)}</div></section></Layout>
