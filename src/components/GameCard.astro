---
import type { GameEntry } from '../lib/types';
import { cats, gameUrl, statusLabel } from '../lib/catalog';
const { game, eager = false } = Astro.props as { game: GameEntry; eager?: boolean };
const search = `${game.title} ${game.aliases.join(' ')} ${game.engine} ${game.platform} ${game.genre} ${game.year}`.toLowerCase();
---
<li class="pc-item" data-cats={cats(game).join('|')} data-search={search} data-id={game.id} data-title={game.title}>
  <a class="poster-card" href={gameUrl(game.id)}>
    <span class="poster-art">
      {game.image
        ? <img src={game.image} alt="" width="640" height="480" loading={eager ? 'eager' : 'lazy'} />
        : <span class="poster-type"><span>{game.platform} · {game.year}</span><strong>{game.title}</strong></span>}
    </span>
    <span class="poster-body">
      <span class="poster-title">{game.title}</span>
      <span class="poster-meta">{game.platform} · {game.genre} · {statusLabel(game)}</span>
      <span class="poster-play">▶ Play free</span>
    </span>
  </a>
</li>
