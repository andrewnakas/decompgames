---
import type {GameEntry} from '../lib/types';
import {labels} from '../lib/catalog';
const {game,index=0}=Astro.props as {game:GameEntry;index?:number};
---
<article class="game-card" data-card data-title={`${game.title} ${game.aliases.join(' ')} ${game.engine}`.toLowerCase()} data-mode={game.mode} data-genre={game.genre} data-kind={game.kind}>
<a href={`/games/${game.id}/`} class="card-art" style={`--game-color:${game.color}`} tabindex="-1" aria-hidden="true">{game.image?<img src={game.image} alt="" width="640" height="400" loading={index<3?'eager':'lazy'}/>:<div class="type-cover"><span>{game.engine}</span><strong>{game.title}</strong><small>{game.year} / {game.kind.toUpperCase()}</small></div>}<span class:list={['mode-badge',game.mode]}>{game.mode==='project'?'PROJECT':game.verification.status!=='gameplay-tested'?'TEST BUILD':game.mode==='instant'?'↗ INSTANT PLAY':'＋ YOUR FILES'}</span><span class="art-play" aria-hidden="true">↗</span></a>
<div class="card-copy"><div class="card-meta"><span>{game.genre}</span><span>{game.year}</span></div><h3><a href={`/games/${game.id}/`}>{game.title}</a></h3><p>{game.description}</p><div class="card-bottom"><span>{game.kind}</span><a href={`/games/${game.id}/`} aria-label={`${labels[game.mode]}: ${game.title}`}>{game.mode==='project'?'Explore':'Play'} <span aria-hidden="true">↗</span></a></div></div></article>
